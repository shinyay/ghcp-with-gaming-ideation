{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://star-relay.invalid/schemas/archive-timeline.schema.json",
  "title": "STAR RELAY archive timeline",
  "description": "Fictional source dates recorded as metadata. These dates are never written into Git history.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classification", "date_semantics", "entries"],
  "properties": {
    "schema_version": { "const": 1 },
    "classification": { "const": "demo-safe" },
    "date_semantics": { "const": "fictional-metadata-only" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "fictional_date", "phase", "label_ja"],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^DRV-[0-9]{3}$" },
          "fictional_date": { "type": "string", "format": "date" },
          "phase": {
            "type": "string",
            "enum": [
              "proposal-1996",
              "location-test-1996",
              "transition-1997",
              "production-1998",
              "qa-1998",
              "release-1998"
            ]
          },
          "label_ja": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
