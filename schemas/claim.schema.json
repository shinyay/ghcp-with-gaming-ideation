{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://star-relay.invalid/schemas/claim.schema.json",
  "title": "STAR RELAY claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "classification",
    "status",
    "asset_id",
    "locator",
    "statement_kind",
    "statement",
    "does_not_establish"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^CLM-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "const": "demo-safe" },
    "status": { "const": "single-source-reading" },
    "asset_id": { "type": "string", "pattern": "^DRV-[0-9]{3}$" },
    "locator": {
      "type": "string",
      "pattern": "^(md:heading|json:pointer|csv:row|csv:column|c:symbol|c:define)/.+"
    },
    "statement_kind": {
      "type": "string",
      "enum": ["literal-value", "literal-text", "absence-of-record"]
    },
    "statement": { "type": "string", "minLength": 1 },
    "does_not_establish": { "type": "string", "minLength": 1 }
  }
}
