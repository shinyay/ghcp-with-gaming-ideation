{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://star-relay.invalid/schemas/release-build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "classification",
    "repository_access_required",
    "pages_published",
    "source_commit",
    "lineage_snapshot_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "const": "REL-001" },
    "classification": { "const": "demo-safe" },
    "repository_access_required": { "const": "private" },
    "pages_published": { "const": false },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "lineage_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "additionalItems": false,
      "items": [
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "demo-site.zip" },
                "start_anchor": { "const": "#museum" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "star-relay-1998-playable.zip" },
                "start_anchor": { "const": "#legacy" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "second-hand-vertical-slice.zip" },
                "start_anchor": { "const": "#second-hand" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/artifact" },
            {
              "type": "object",
              "properties": {
                "name": { "const": "offline-demo-pack.zip" },
                "start_anchor": { "const": "#museum" }
              }
            }
          ]
        }
      ]
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "bytes",
        "entrypoint",
        "start_anchor"
      ],
      "properties": {
        "name": { "type": "string" },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "entrypoint": { "const": "index.html" },
        "start_anchor": { "type": "string" }
      }
    }
  }
}
