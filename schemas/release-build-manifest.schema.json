{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://star-relay.invalid/schemas/release-build-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "classification",
    "repository_access_required",
    "pages_published",
    "source_commit",
    "lineage_snapshot_sha256",
    "artifacts"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release_id": { "const": "REL-001" },
    "classification": { "const": "demo-safe" },
    "repository_access_required": { "const": "private" },
    "pages_published": { "const": false },
    "source_commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "lineage_snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "sha256",
          "bytes",
          "entrypoint",
          "start_anchor"
        ],
        "properties": {
          "name": {
            "enum": [
              "demo-site.zip",
              "star-relay-1998-playable.zip",
              "second-hand-vertical-slice.zip",
              "offline-demo-pack.zip"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": { "type": "integer", "minimum": 1 },
          "entrypoint": { "const": "index.html" },
          "start_anchor": {
            "enum": ["#museum", "#legacy", "#second-hand"]
          }
        }
      }
    }
  }
}
