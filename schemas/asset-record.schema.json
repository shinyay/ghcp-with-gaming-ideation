{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://star-relay.invalid/schemas/asset-record.schema.json",
  "title": "STAR RELAY asset record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "classification",
    "origin_kind",
    "derivation_kind",
    "source_ref",
    "source_created_at",
    "ingested_at",
    "media_type",
    "path",
    "src_sha256",
    "transform_id",
    "transform_version",
    "transform_config_sha256",
    "derived_hash_projection",
    "derived_sha256",
    "locator_grammar_version",
    "locators",
    "review_status",
    "ai_eligible",
    "package_allowed",
    "contains_free_text"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^DRV-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "const": "demo-safe" },
    "origin_kind": { "const": "synthetic_fixture" },
    "derivation_kind": { "const": "directly_authored_fixture" },
    "source_ref": { "type": "string", "pattern": "^SRC-[0-9]{3}$" },
    "source_created_at": { "type": "string", "format": "date" },
    "ingested_at": { "type": "string", "format": "date-time" },
    "media_type": { "type": "string", "minLength": 1 },
    "path": { "type": "string", "pattern": "^archive/derived/" },
    "src_sha256": {
      "oneOf": [
        { "$ref": "#/definitions/sha256" },
        { "type": "null" }
      ]
    },
    "transform_id": {
      "oneOf": [
        { "type": "string", "pattern": "^transform:[a-z0-9-]+$" },
        { "type": "null" }
      ]
    },
    "transform_version": {
      "oneOf": [
        { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        { "type": "null" }
      ]
    },
    "transform_config_sha256": {
      "oneOf": [
        { "$ref": "#/definitions/sha256" },
        { "type": "null" }
      ]
    },
    "derived_hash_projection": { "const": "utf8-nfc-lf-v1" },
    "derived_sha256": { "$ref": "#/definitions/sha256" },
    "locator_grammar_version": {
      "type": "string",
      "enum": ["sr-loc/v1", "sr-loc/v2"]
    },
    "locators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/locator" }
    },
    "review_status": {
      "type": "string",
      "enum": ["fixture-reviewed", "needs-review"]
    },
    "ai_eligible": { "type": "boolean" },
    "package_allowed": { "type": "boolean" },
    "contains_free_text": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "derivation_kind": { "const": "directly_authored_fixture" }
        }
      },
      "then": {
        "properties": {
          "src_sha256": { "const": null },
          "transform_id": { "const": null },
          "transform_version": { "const": null },
          "transform_config_sha256": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": {
          "locator_grammar_version": { "const": "sr-loc/v1" }
        },
        "required": ["locator_grammar_version"]
      },
      "then": {
        "properties": {
          "locators": {
            "type": "array",
            "items": { "$ref": "#/definitions/locatorV1" }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "locator": {
      "type": "string",
      "pattern": "^(md:heading|json:pointer|csv:row|csv:column|c:symbol|c:define)/.+$"
    },
    "locatorV1": {
      "type": "string",
      "pattern": "^(md:heading|json:pointer)/.+$"
    }
  }
}
