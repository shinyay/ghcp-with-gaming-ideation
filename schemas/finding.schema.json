{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://star-relay.invalid/schemas/finding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "classification",
    "status",
    "evidence",
    "finding",
    "limits",
    "review"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^FND-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "classification": { "const": "demo-safe" },
    "status": { "const": "reviewed" },
    "evidence": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_id", "locator"],
        "properties": {
          "asset_id": { "type": "string", "pattern": "^DRV-[0-9]{3}$" },
          "locator": {
            "type": "string",
            "pattern": "^(md:heading|json:pointer|csv:row|csv:column|c:symbol|c:define)/.+"
          }
        }
      }
    },
    "finding": { "type": "string", "minLength": 1 },
    "limits": { "type": "string", "minLength": 1 },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "reviewer_role", "reviewed_at", "source"],
      "properties": {
        "method": { "const": "two-source-owner-checklist" },
        "reviewer_role": { "const": "repository-owner" },
        "reviewed_at": { "type": "string", "format": "date-time" },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  }
}
