{
  "schema_version": 1,
  "id": "RESET-001",
  "destructive": false,
  "generated_targets": [
    "dist/demo-site",
    "dist/offline-demo-pack",
    "dist/release",
    "dist/release-staging",
    "dist/release-smoke",
    "test-results",
    "playwright-report"
  ],
  "rebuild_commands": [
    "npm run package:release",
    "npm run verify:release"
  ],
  "ready_when": [
    "dist/offline-demo-pack/index.html exists",
    "dist/offline-demo-pack/build-manifest.json validates",
    "npm run test:offline exits 0"
  ]
}
